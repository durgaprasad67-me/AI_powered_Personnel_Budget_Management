# MongoDB
MONGO_USER=YOUR_MONGODB_USERNAME
MONGO_PASSWORD=YOUR_MONGODB_PASSWORD
MONGO_CLUSTER=YOUR_MONGODB_CLUSTER_URL
DATABASE_NAME=finsight_db


# Gemini LLM
GEMINI_API_KEY=Paste_Your_Actual_Gemini_API_Key_Here
GEMINI_MODEL=gemini-2.5-flash


# Legacy fallback when GEMINI_API_KEYS is unset.
GEMINI_API_KEY_1=YOUR_GEMINI_API_KEY_1
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024


# Gemini embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_EMBEDDING_BATCH_SIZE=100

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=finsight_knowledge
RAG_TOP_K=4
RAG_MIN_SCORE=0.60
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS=2000
RAG_CONTEXT_MAX_CHARS=12000
RAG_DEBUG_CONTEXT=false
