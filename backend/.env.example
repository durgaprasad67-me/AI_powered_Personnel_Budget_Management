# MongoDB
MONGO_USER=Your_MongoDB_Username
MONGO_PASSWORD=Your_MongoDB_Password
MONGO_CLUSTER=Your_MongoDB_Cluster_URL
DATABASE_NAME=Your_Database_Name

# Gemini LLM
GEMINI_API_KEY=Paste_Your_Actual_Gemini_API_Key_Here
